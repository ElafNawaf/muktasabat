# FastAPI (api/)
# Required for JWT signing outside dev. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Rotating it invalidates every issued token (all users are logged out).
SECRET_KEY=change-me-to-a-random-secret-key
# Local SQLite (default in api/config.py if unset):
DATABASE_URL=sqlite:///./muktasbat.db
# Docker / local Postgres:
# DATABASE_URL=postgresql://muktasbat:muktasbat_secret@127.0.0.1:5432/muktasbat

# Next.js (web/) — server-side calls to FastAPI
# API_URL=http://127.0.0.1:8000

# docker compose: host port for the web UI (default 3001 in compose; set WEB_PORT=3000 if nothing uses 3000).
# WEB_PORT=3000

# When true, forgot-password API may return debug_reset_url (local dev only; never in production)
# RESET_PASSWORD_DEBUG=true

# --- AWS credentials (shared by S3 uploads and SES email) ---
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# --- AWS SES (transactional email) — leave blank to log emails to stdout ---
# SES_REGION=ap-south-1
# SES_FROM_EMAIL=no-reply@muktasabat.com
# SES_CONFIGURATION_SET=
# WEB_BASE_URL=https://muktasabat.com

# --- Amazon Translate (auto AR↔EN) — falls back to SES_REGION if unset ---
# TRANSLATE_REGION=us-east-1

# --- File storage (building/unit photos + contract/building documents) ---
# Production: set S3_BUCKET (+ S3_REGION) to enable uploads. Leave blank for
# local disk fallback (or uploads return 503 if LOCAL_UPLOAD_DIR is also unset).
# S3_BUCKET=muktasabat-uploads
# S3_REGION=us-east-1
# S3-compatible endpoint (Cloudflare R2, MinIO, etc.) — leave blank for AWS:
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# Public CDN URL — defaults to https://<bucket>.s3.<region>.amazonaws.com/<key>:
# S3_PUBLIC_BASE_URL=https://cdn.muktasabat.com
# Local fallback (used when S3_BUCKET is empty):
# LOCAL_UPLOAD_DIR=uploads
# API_PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Ejar / منصة إيجار (REGA) ---
# Credentials issued by REGA (الهيئة العامة للعقار) after your establishment is
# approved. Leave EJAR_CLIENT_ID blank to run in STUB mode: every Ejar call is
# simulated locally, so the full flow (validate → register → sync) works in
# development without touching the real platform.
# EJAR_CLIENT_ID=
# EJAR_CLIENT_SECRET=
# Sandbox: https://staging.api.ejar.sa   Production: https://api.ejar.sa
# EJAR_BASE_URL=https://api.ejar.sa
# Set to false only once real credentials are in place.
# EJAR_STUB_MODE=true
